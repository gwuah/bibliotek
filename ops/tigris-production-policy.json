{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListTheBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": ["arn:aws:s3:::bibliotek"]
    },
    {
      "Sid": "ReadEveryObject",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": ["arn:aws:s3:::bibliotek/*"]
    },
    {
      "Sid": "WriteOnlyInsideLiotekNamespace",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:AbortMultipartUpload", "s3:ListMultipartUploadParts"],
      "Resource": ["arn:aws:s3:::bibliotek/liotek/production/*"]
    },
    {
      "Sid": "DeleteOnlyScheduledBackups",
      "Effect": "Allow",
      "Action": ["s3:DeleteObject"],
      "Resource": ["arn:aws:s3:::bibliotek/liotek/production/backups/scheduled/*"]
    }
  ]
}
